(deflayer base
  @plain-toggle @pgupdn @endhome
  tab            q       w        e         r         t  y  u         i         o        p               [     ]    \
  @esc-nav       @a-alt  @s-ctrl  @d-super  @f-shift  g  h  @j-shift  @k-super  @l-ctrl  @semicolon-alt  '     ret
  @shift-symnum  z       x        c         v         b  n  m         ,         .        /               rsft
  lctl           lmet    bspc                   @space-num                   @change-lang      rctl
)

(defalias
  pgupdn
    (t! doubletap pgup pgdn)
  endhome
    (t! doubletap end home)

  esc-nav
    (t! taphold esc (layer-while-held navigation))
  space-num
    (t! taphold spc (t! layer-persist symnum))
  shift-symnum
    (t! taphold (one-shot 1000 (layer-while-held symnum)) lsft)

  change-lang
    A-C-M-S-l
  plain-toggle
    (layer-switch plain)
)

(defalias
  chxtf (chord text f)
  chxtj (chord text j)
  chxtk (chord text k)
)

(defchords text $hold-time
  (f      ) f
  (   j   ) j
  (      k) k
  (   j  k) ret
  (f  j   ) bspc
  (f     k) del
)

;; HRM -> ACGS -> G: Super, S: Shift
(defalias
  a-alt
    (t! taphold a lalt)
  s-ctrl
    (t! taphold s lctl)
  d-super
    (t! taphold d lmet)
  f-shift
    (t! taphold @chxtf lsft)

  j-shift
    (t! taphold @chxtj rsft)
  k-super
    (t! taphold @chxtk lmet)
  l-ctrl
    (t! taphold l rctl)
  semicolon-alt
    (t! taphold ; ralt)
)
