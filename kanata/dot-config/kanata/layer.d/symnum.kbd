(deflayermap (symnum)
  _ nop9

  caps (layer-switch navigation)

  q S-2   ;; @ recording in vim
  w S-8   ;; *
  e Equal ;; = equals
  r S-4   ;; $ Rials?
  t S-3   ;; # tag
  y S-1   ;; ! not

  a @lsym-alt
  s @lsym-ctrl
  d @lsym-super
  f @lsym-shift
  g S-Minus     ;; underline

  z S-Equal                       ;; + next to x
  x (t! doubletap Minus S-Equal)  ;; - x is remove
  c Backquote                     ;; ` code block
  v S-6                           ;; ^ flipped
  b Backslash                     ;; \

;; ^LEFT^ - vRIGHTv

  u 7 
  i 8
  o 9
  p S-5
  [ (layer-switch function)

  h S-Backquote ;; home~
  j @rsym-shift ;; 1
  k @rsym-super ;; 2
  l @rsym-ctrl  ;; 3
  ; @rsym-alt   ;; 0

  n 4
  m 5
  , 6
  . _
  / _
)

(defalias
  lsym-alt
    (t! taphold (t! doubletap S-7 S-Backslash) lalt)
  lsym-ctrl
    (t! taphold (t! doubletap [ ]) lctl)
  lsym-super
    (t! taphold (t! doubletap S-[ S-]) lmet)
  lsym-shift
    (t! taphold (t! doubletap S-9 S-0) lsft)

  rsym-shift
    (t! taphold 1 rsft)
  rsym-super
    (t! taphold 2 lmet)
  rsym-ctrl
    (t! taphold 3 rctl)
  rsym-alt
    (t! taphold 0 ralt)
)
