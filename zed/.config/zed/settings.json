// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "helix_mode": true,
  "languages": {
    "C++": {
      "soft_wrap": "none"
    }
  },
  "ui_font_weight": 400.0,
  "diff_view_style": "split",
  "cli_default_open_behavior": "existing_window",
  "proxy": "socksh://localhost:8119",
  "collaboration_panel": {
    "dock": "right"
  },
  "format_on_save": "off",
  "show_signature_help_after_edits": true,
  "window_decorations": "client",
  "title_bar": {
    "show_branch_status_icon": true
  },
  "close_on_file_delete": true,
  "completions": {
    "lsp_insert_mode": "replace_subsequence"
  },
  "image_viewer": {
    "unit": "decimal"
  },
  "extend_comment_on_newline": false,
  "middle_click_paste": false,
  "gutter": {
    "min_line_number_digits": 4
  },
  "relative_line_numbers": "enabled",
  "auto_signature_help": false,
  "which_key": {
    "enabled": true
  },
  "ssh_connections": [
    {
      "host": "amnafzarPC",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/amnafzar/Documents/sator"
          ]
        }
      ]
    },
    {
      "host": "amnafzarLocalCoder",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/coder/src/openvpn/./"
          ]
        },
        {
          "paths": [
            "/home/coder/src/spcm"
          ]
        }
      ]
    }
  ],
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
      "min_column": 80,
    },
  },
  "terminal": {
    "font_size": 13.0,
    "alternate_scroll": "off",
    "cursor_shape": "underline",
  },
  "git_panel": {
    "dock": "left",
    "tree_view": false,
    "default_width": 300.0,
  },
  "outline_panel": {
    "dock": "left",
    "indent_size": 10.0,
    "default_width": 235.0,
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 10.0,
    "default_width": 210.0,
    "hide_gitignore": true,
  },
  "active_pane_modifiers": {
    "border_size": 0.2,
    "inactive_opacity": 0.9,
  },
  "tabs": {
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true,
  },
  "seed_search_query_from_cursor": "selection",
  "search": {
    "center_on_match": true,
    "regex": true,
  },
  "use_smartcase_search": true,
  "diagnostics": {
    "inline": {
      "enabled": true,
      "padding": 5,
    },
  },
  "disable_ai": true,
  "colorize_brackets": true,
  "indent_guides": {
    "coloring": "indent_aware",
  },
  "tab_size": 2,
  "vim": {
    "cursor_shape": {
      "replace": "hollow",
      "normal": "underline",
    },
    "use_smartcase_find": true,
    "use_system_clipboard": "on_yank",
    "toggle_relative_line_numbers": true,
  },
  "toolbar": {
    "agent_review": false,
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Tokyo Night"
  },
  "agent": {
    "dock": "right",
    "button": false,
  },
  "redact_private_values": true,
  "vim_mode": false,
  "base_keymap": "Emacs",
  "ui_font_family": ".ZedSans",
  "ui_font_size": 15.0,
  "buffer_font_size": 14.0,
  "buffer_font_family": ".ZedMono",
  "buffer_font_fallbacks": ["JetBrainsMono Nerd Font", "FiraCode Nerd Font"],
  "file_types": {
    "toml": ["*.cnf"],
  },
  "theme_overrides": {
      "Tokyo Night": {
        "background.appearance": "transparent",
        "editor.background": "#1a1b2688",
        "syntax": {
          "comment": {
            "font_style": "italic"
          },
          "comment.doc": {
            "font_style": "italic"
          },
          "keyword": {
            "font_style": "italic"
          },
          "constant": {
            "font_style": "oblique"
          }
        }
      }
    }
}
