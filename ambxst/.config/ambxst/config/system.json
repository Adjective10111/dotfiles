{
  "disks": [
    "/",
    "/home"
  ],
  "updateServiceEnabled": true,
  "idle": {
    "general": {
      "lock_cmd": "~/.local/share/quickshell-lockscreen/lock.sh",
      "before_sleep_cmd": "loginctl lock-session",
      "after_sleep_cmd": "ambxst screen on"
    },
    "listeners": [
      {
        "onResume": "ambxst brightness -r",
        "onTimeout": "ambxst brightness -50 -s",
        "timeout": 150
      },
      {
        "onTimeout": "loginctl lock-session",
        "timeout": 300
      },
      {
        "onResume": "ambxst screen on; ambxst brightness -r",
        "onTimeout": "ambxst screen off",
        "timeout": 330
      }
    ]
  },
  "ocr": {
    "eng": true,
    "spa": false,
    "lat": false,
    "jpn": false,
    "chi_sim": false,
    "chi_tra": false,
    "kor": false
  },
  "pomodoro": {
    "workTime": 1500,
    "restTime": 300,
    "autoStart": false,
    "syncSpotify": false
  }
}