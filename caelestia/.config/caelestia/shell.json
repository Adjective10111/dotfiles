{
    "appearance": {
        "transparency": {
            "enabled": true
        }
    },
    "bar": {
        "activeWindow": {
            "compact": false,
            "inverted": true,
            "showOnHover": false
        },
        "clock": {
            "background": true,
            "showDate": true,
            "showIcon": false
        },
        "persistent": true,
        "popouts": {
            "activeWindow": false
        },
        "scrollActions": {
            "brightness": false,
            "volume": false
        },
        "status": {
            "showAudio": true,
            "showBattery": false,
            "showKbLayout": true,
            "showLockStatus": true,
            "showMicrophone": true,
            "showNetwork": true,
            "showWifi": true
        },
        "tray": {
            "background": true,
            "compact": true,
            "recolour": true
        },
        "workspaces": {
            "activeIndicator": true,
            "activeTrail": false,
            "occupiedBg": false,
            "showWindows": true,
            "showWindowsOnSpecialWorkspaces": true
        }
    },
    "dashboard": {
        "performance": {
            "showBattery": false
        },
        "showMedia": false
    },
    "general": {
        "apps": {
            "explorer": [
                "dolphin"
            ],
            "playback": [
                "/usr/bin/vlc",
                "--started-from-file"
            ],
            "terminal": [
                "foot"
            ]
        }
    },
    "launcher": {
        "showOnHover": false,
        "useFuzzy": {
            "actions": true,
            "apps": true
        },
        "vimKeybinds": true
    },
    "nexus": {
        "networkRescanInterval": 60000
    },
    "services": {
        "audioIncrement": 0.05,
        "brightnessIncrement": 0.05,
        "gpuType": "NVIDIA",
        "useTwelveHourClock": false
    },
    "sidebar": {
        "enabled": true
    },
    "utilities": {
        "toasts": {
            "fullscreen": "important",
            "nowPlaying": true
        }
    }
}
